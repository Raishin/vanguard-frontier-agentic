{
  "provider": "python",
  "domains": {
    "system-inventory": {
      "keywords": [
        "inventory",
        "discover",
        "asset register",
        "owner",
        "deployment revision",
        "service identity",
        "criticality"
      ],
      "agent": "python-live-system-inventory-agent"
    },
    "identity-authority": {
      "keywords": [
        "identity",
        "credential age",
        "JIT",
        "approval authority",
        "requester",
        "approver",
        "standing privilege",
        "shared account"
      ],
      "agent": "python-live-identity-authority-agent"
    },
    "runtime-control": {
      "keywords": [
        "interpreter",
        "process",
        "worker",
        "thread",
        "memory health",
        "diagnostics",
        "live state"
