  "live_guards": [
    "python-live-code-remediation-agent",
    "python-live-release-control-agent",
    "python-live-data-change-control-agent",
    "python-live-job-control-agent",
    "python-live-model-promotion-control-agent",
    "python-live-rollback-and-recovery-agent"
  ],
  "gate_mode": "live-guard-gate",
  "live_guard_intent": "\\b(deploy|canary|restart|migrate|backfill|reprocess)\\b|\\b(execute|run|perform|apply|trigger|do)\\b[^.]*\\b(release|rollback|migration|backfill|job|remaining|records?)\\b|\\bpromote\\b[^.]*\\b(model|artifact)\\b|\\b(create|open|raise)\\b[^.]*\\b(branch|pull request|\\bpr\\b)\\b|\\bmerge\\b|\\brelease\\b\\s+(to|into)\\b|\\bretry\\b[^.]*\\b(all|failed|job)\\b",
  "parallel_threshold": 0.7
}
