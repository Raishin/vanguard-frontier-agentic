    "release-control": {
      "keywords": [
        "bounded release",
        "canary increment",
        "one-instance restart"
      ],
      "agent": "python-live-release-control-agent"
    },
    "data-change-control": {
      "keywords": [
        "data-change migration",
        "production backfill",
        "pipeline reprocessing",
        "bounded data correction"
      ],
      "agent": "python-live-data-change-control-agent"
    },
    "job-control": {
      "keywords": [
        "distributed job",
        "business automation job",
        "job requeue"
      ],
